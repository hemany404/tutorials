<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="test_model_action" model="ir.actions.act_window">
    <field name="name">lista de propriedades</field>
    <field name="res_model">test_model</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Cadastre aqui uma nova propriedade imobiliária!
        </p>
    </field>
</record>


<record id="test_model_search" model="ir.ui.view">
        <field name="name">test model search</field>
        <field name="model">test_model</field>
        <field name="arch" type="xml">
            <search string="Buscar Propriedades">
                <!-- Atalhos de pesquisa -->
                <field name="nome"/>
                <field name="preco_esperado"/>
                <field name="state"/>
                
                <!-- Filtros -->
                <filter name="available" 
                        string="Disponíveis" 
                        domain="[('state', 'in', ['new', 'offer_received'])]"/>
                
                <!-- Agrupamento -->
                <filter name="group_by_postal" 
                        string="Código Postal" 
                        context="{'group_by': 'codigo_postal'}"/>
            </search>
        </field>
</record>

<record id="test_model_view" model="ir.ui.view">
        <field name="name">test model list</field>
        <field name="model">test_model</field>
        <field name="arch" type="xml">
            <list default_order="nome asc" string="Propriedade">
                <field name="sequence" widget="handle"/>
                <field name="nome"/>  
                <field name="codigo_postal"/> 
                <field name="quartos"/>
                <field name="area_estar"/>    
                <field name="preco_esperado"/>  
                <field name="preco_venda"/>  
                <field name="data_disponivel"/>
            </list>
        </field>
</record>

<record id='test_model_form' model='ir.ui.view'>
        <field name="name">test model form</field>
        <field name="model">test_model</field>
        <field name="arch" type="xml">
            <form string="Propriedade">
              <header>
                    <button name="action_cancel" 
                    string="Cancelar" 
                    type="object" 
                    class="btn-danger" 
                    invisible="state not in ('new','offer_received','offer_accepted')"/>

                    <button name="action_sold" 
                    string="Vender" 
                    type="object" 
                    class="btn-success" 
                    invisible="state not in ('new','offer_received','offer_accepted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
              </header>         
                <sheet>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <group>
                            <field name='tipo_propiedade' options="{'no_create':True, 'no_edit':True}"/>
                            <field name="codigo_postal" />
                            <field name="data_disponivel"/>
                        </group>
                        <group>
                            <field name="preco_esperado"/>
                            <field name="preco_venda"/>
                            <field name="best_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrição">
                        <group>
                            <group>
                                <field name="nome"/>
                                <field name="descricao"/>
                                <field name='quartos'/>
                                <field name='area_estar'/>
                                <field name='fachadas'/>
                            </group>
                            <group>   
                                <field name='garagem'/>
                                <field name='jardim'/>
                                <field name='jardim_area'/>
                                <field name='jardim_orientacao'/>
                                <field name='total_area'/>
                            </group>   
                         </group> 
                        </page>
                        <page string="Ofertas">
                            <field name="offer_ids" readonly="state in ['sold','canceled','offer_accepted']">
                                <list string="Ofertas">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="status"/>
                                    <button name="action_accept" string="Aceitar" type="object" icon="fa-check" class="btn-success" invisible="status  in ['accepted','refused']" />
                                    <button name="action_refuse" string="Recusar" type="object" icon="fa-times" class="btn-danger" invisible="status  in ['accepted','refused']"/>
                                    <field name="validaty"/>
                                    <field name="data_limite"/>
                                </list>
                            </field>
                        </page>
                        <page string="Outras info">
                        <group>
                            <group>
                                <field name="comprador_id"/>
                                <field name="vendedor_id"/>
                            </group>  
                         </group> 
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
</record>        
</odoo>