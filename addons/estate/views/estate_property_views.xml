<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="test_model_action" model="ir.actions.act_window">
    <field name="name">Test action</field>
    <field name="res_model">test_model</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
            Cadastre aqui uma nova propriedade imobiliária!
        </p>
    </field>
</record>

<search string="Buscar Propriedades">
    <!-- Atalhos de pesquisa -->
    <field name="name"/>
    <field name="expected_price"/>
    <field name="state"/>
    
    <!-- Filtros -->
    <filter name="available" 
            string="Disponíveis" 
            domain="[('state', 'in', ['new', 'offer_received'])]"/>
    
    <!-- Agrupamento -->
    <filter name="group_by_postal" 
            string="Código Postal" 
            context="{'group_by': 'postal_code'}"/>
</search>


<record id="test_model_view" model="ir.ui.view">
        <field name="name">test model list</field>
        <field name="model">test_model</field>
        <field name="arch" type="xml">
            <list string="Propriedade">
                <field name="nome"/>  
                <field name="codigo_postal"/> 
                <field name="quartos"/>
                <field name="area_estar"/>    
                <field name="preco_esperado"/>  
                <field name="preco_venda"/>  
                <field name="data_disponivel"/>
            </list>
        </field>
</record>

<record id='test_model_form' model='ir.ui.view'>
        <field name="name">test model form</field>
        <field name="model">test_model</field>
        <field name="arch" type="xml">
            <form string="Propriedade">
                <sheet>
                    <group>
                        <group>
                            <field name="codigo_postal"/>
                            <field name="data_disponivel"/>
                        </group>
                        <group>
                            <field name="preco_esperado"/>
                            <field name="preco_venda"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descrição">
                         <group>
                            <field name="nome"/>
                            <field name="descricao"/>
                            <field name='quartos'/>
                            <field name='area_estar'/>
                            <field name='fachadas'/>
                         </group>
                         <group>   
                            <field name='garagem'/>
                            <field name='jardim'/>
                            <field name='jardim_area'/>
                            <field name='jardim_orientacao'/>
                         </group>   
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
</record>        
</odoo>