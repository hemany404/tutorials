<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="test_model_type_action" model="ir.actions.act_window">
        <field name="name">Tipos de Propriedades</field>
        <field name="res_model">test_model_type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cadastre aqui um novo  tipo propriedade imobiliária!
            </p>
        </field>
    </record> 

    <record id="test_model_type_view" model="ir.ui.view">
        <field name="name">Lista de propriedades</field>
        <field name="model">test_model_type</field>
        <field name="arch" type="xml">
            <list string="Propriedade">
                <field name="nome"/>  
            </list>
        </field>
</record>



</odoo>