<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="test_model_offer_action" model="ir.actions.act_window">
        <field name="name">Ofertas</field>
        <field name="res_model">test_model_offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cadastre aqui um novo  tipo propriedade imobiliária!
            </p>
        </field>
    </record> 

    <record id="test_model_tag_view" model="ir.ui.view">
        <field name="name">Lista de Ofertas</field>
        <field name="model">test_model_offer</field>
        <field name="arch" type="xml">
            <list string="Ofertas">
                <field name="price"/>  
                <field name="validaty"/>  
                <field name="data_limite"/>  
            </list>
        </field>
</record>



</odoo>